{
  "name": "filmgraph",
  "private": true,
  "description": "CLIO — Continuity & Lineage Intelligence Operator",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "build": "vite build && node scripts/ensure-firebase-index.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "capture": "tsx scripts/capture-workflow.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm e2e && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-start": "^1.168.50",
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rolldown/binding-darwin-arm64": "^1.2.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
