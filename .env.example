# CLIO local defaults — Continuity & Lineage Intelligence Operator
CLIO_ENV=local
GRAPH_QUERY_MODE=auto
AGENT_MODE=live
AGENT_PROVIDER_URL=https://openrouter.ai/api/v1/chat/completions
AGENT_PROVIDER_MODEL=deepseek/deepseek-v4-flash-0731
AGENT_PROVIDER_API_KEY=

# Optional read-only ClickHouse MCP adapter (tried before direct ClickHouse)
CLIO_MCP_ENDPOINT=
CLIO_MCP_COMMAND=
CLIO_GITHUB_TOKEN=

# Optional direct ClickHouse fallback / primary store
CLIO_CLICKHOUSE_HOST=127.0.0.1
CLIO_CLICKHOUSE_PORT=8123
CLIO_CLICKHOUSE_USER=clio
CLIO_CLICKHOUSE_PASSWORD=clio-local
CLIO_CLICKHOUSE_DATABASE=filmgraph
CLIO_CLICKHOUSE_SECURE=false
CLIO_USE_MEMORY_STORE=false
# Database lifecycle controls. Cloud can use the same schema with:
# CLIO_DATABASE_MODE=cloud, port 8443, secure=true, database=clio.
CLIO_DATABASE_MODE=local
CLIO_BOOTSTRAP_SCHEMA=true
CLIO_CREATE_DATABASE=true
CLIO_SEED_DEMO=true
CLIO_ALLOW_DEMO_RESET=false

# Managed Google ADK / Agent Runtime model order. The deployment creates an
# Agent Runtime resource for each Gemini candidate; Cloud Run must attempt
# them in this order before falling back to the OpenRouter credentials above.
CLIO_GEMINI_MODEL_PRIMARY=gemini-3.8-flash
CLIO_GEMINI_MODEL_FALLBACK_1=gemini-3.7-flash
CLIO_GEMINI_MODEL_FALLBACK_2=gemini-2.5-flash
CLIO_AGENT_RUNTIME_PRIMARY_RESOURCE=
CLIO_AGENT_RUNTIME_FALLBACK_1_RESOURCE=
CLIO_AGENT_RUNTIME_FALLBACK_2_RESOURCE=
CLIO_AGENT_RUNTIME_RESOURCES=
# Read-only Cloud Run boundary used by deployed ADK agent tools. The deploy
# script resolves this automatically from the clio-api service when omitted.
CLIO_AGENT_API_BASE_URL=
# Gemini 3.x uses the global Vertex model endpoint; Agent Runtime resources
# themselves remain in a supported regional control plane location.
CLIO_AGENT_VERTEX_LOCATION=global
CLIO_MEMORY_BANK_RESOURCE=
CLIO_AGENT_EVENT_TRANSPORT=poll

# Future live Gemini/ADK provider (Vertex switch)
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# TanStack server-side bridge and opt-in capture
CLIO_API_URL=http://127.0.0.1:8000
CLIO_BASE_URL=http://127.0.0.1:3000
CLIO_CAPTURE_DIR=
